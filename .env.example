BOT_TOKEN=
ANTHROPIC_API_KEY=
# Ваш Telegram ID — только вам бот отвечает на команды и шлёт уведомления
ADMIN_ID=
# Часовой пояс расписания постов
TZ_NAME=Asia/Novosibirsk
# Необязательно: ID канала вручную. Обычно не нужен — бот запоминает канал, когда его добавляют администратором
# CHANNEL_ID=
# Пост, просроченный больше чем на N часов (бот был выключен), сам не публикуется — бот спросит
# MISSED_HOURS=12
# CONTENT_MODEL=claude-sonnet-5
